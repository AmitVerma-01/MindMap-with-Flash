# OpenRouter AI configuration
OPENROUTER_API_KEY=your_openrouter_api_key

# Primary model (optional — first in fallback chain)
OPENROUTER_MODEL_PRIMARY=your/preferred-model

# Legacy alias still supported
OPENROUTER_MODEL_DEEPSEEK=your/preferred-model

# Optional comma-separated override for fallbacks (defaults built-in):
# nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free
OPENROUTER_MODEL_FALLBACKS=

# App URL for OpenRouter headers
NEXT_PUBLIC_APP_URL=https://mindmapwithflash.kodeeslabs.com

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/pages/flashcards
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pages/flashcards

# PostgreSQL (Aiven or local)
DATABASE_URL=postgresql://user:password@host:port/defaultdb?sslmode=require
